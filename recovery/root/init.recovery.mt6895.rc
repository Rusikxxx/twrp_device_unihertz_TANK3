import /init.recovery.trustkernel.rc

on init
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64/hw

on boot
    start health-hal-2-1
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils

on fs
       mkdir /mnt/vendor 0700 root root
       mkdir /mnt/vendor/persist 0700 root root
       mount ext4 /dev/block/by-name/persist /mnt/vendor/persist
       mkdir /mnt/vendor/protect_f 0700 root root
       mount ext4 /dev/block/by-name/protect_f /mnt/vendor/protect_f

    install_keyring
    wait /dev/block/platform/bootdevice
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    start boot-hal-1-2

service vendor.keymint-trustkernel /system/bin/android.hardware.security.keymint-service.trustkernel
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true
    start vendor.keymint-trustkernel
    start vendor.gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop teed
    stop vendor.keymint-trustkernel
    stop vendor.gatekeeper-1-0
    
on property:ro.crypto.state=unencrypted
    stop teed
    stop vendor.keymint-trustkernel
    stop vendor.gatekeeper-1-0

on property:twrp.all.users.decrypted=true
    stop teed
    stop vendor.keymint-trustkernel
    stop vendor.gatekeeper-1-0
